#!/usr/bin/env bash
set -euo pipefail

SVC="${SUPASWAP_SERVICE:-supaswap}"
CLI_SVC="${SUPASWAP_CLI_SERVICE:-Supabase CLI}"
CLI_ACCT="${SUPASWAP_CLI_ACCOUNT:-supabase}"
LOGIN="${SUPASWAP_LOGIN:-supabase login --no-browser}"

die() { echo "$*" >&2; exit 1; }
help() {
  cat <<'TXT'
usage: supaswap <command> [name]

Switch which account the Supabase CLI is logged in as.
Saved logins live in the macOS Keychain.

commands:
  save <name>   save the account the CLI is logged in as right now
  use <name>    log the CLI in as a saved account
  ls            list saved accounts (* marks the active one)
  rm <name>     delete a saved account
  help          show this help

add an account:  supabase login, then supaswap save <name>
names:           letters, digits, . _ -
TXT
}
usage() { help >&2; exit 1; }
get() { security find-generic-password -s "$1" -a "$2" -w 2>/dev/null; }
# Token goes through security's stdin, never argv, so it can't show up in ps.
put() { printf 'add-generic-password -U -s "%s" -a "%s" -w "%s"\n' "$1" "$2" "$3" | security -i >/dev/null; }

cmd="${1:-}"; name="${2:-}"
case "$cmd" in
  save|use|rm) [[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || usage ;;
  ls) ;;
  help|-h|--help) help; exit 0 ;;
  *) usage ;;
esac

case "$cmd" in
  save)
    rc=0; tok=$(get "$CLI_SVC" "$CLI_ACCT") || rc=$?
    [ "$rc" = 44 ] && die "not logged in; run supabase login first"
    [ "$rc" = 0 ] || die "can't read Supabase CLI login from Keychain (access denied?)"
    # Older Go builds of the CLI stored the token base64-wrapped.
    case "$tok" in go-keyring-base64:*) tok=$(printf '%s' "${tok#go-keyring-base64:}" | base64 -D) ;; esac
    [[ "$tok" =~ ^sbp_[A-Za-z0-9_]+$ ]] || die "unexpected Supabase CLI token format; not saved"
    put "$SVC" "$name" "$tok"
    get "$SVC" "$name" >/dev/null || die "failed to save $name"
    echo "saved $name" ;;
  use)
    tok=$(get "$SVC" "$name") || die "no saved account: $name"
    [ -z "${SUPABASE_ACCESS_TOKEN:-}" ] || echo "warning: SUPABASE_ACCESS_TOKEN is set and overrides the stored login" >&2
    printf '%s\n' "$tok" | $LOGIN
    echo "now using $name" ;;
  rm)
    security delete-generic-password -s "$SVC" -a "$name" >/dev/null 2>&1 || die "no saved account: $name"
    echo "removed $name" ;;
  ls)
    cur=$(get "$CLI_SVC" "$CLI_ACCT" || true)
    # dump-keychain without -d prints attributes only, never secrets.
    security dump-keychain | awk -v s="$SVC" '
      /^keychain:/     { if (sv == s && a != "") print a; a = ""; sv = "" }
      /"acct"<blob>=/  { sub(/.*"acct"<blob>="/, ""); sub(/"$/, ""); a = $0 }
      /"svce"<blob>=/  { sub(/.*"svce"<blob>="/, ""); sub(/"$/, ""); sv = $0 }
      END              { if (sv == s && a != "") print a }' | sort -u |
    while read -r n; do
      if [ -n "$cur" ] && [ "$(get "$SVC" "$n")" = "$cur" ]; then echo "* $n"; else echo "  $n"; fi
    done ;;
esac
